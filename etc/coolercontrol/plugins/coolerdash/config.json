{
  "_comment": "CoolerDash Plugin Configuration - All values with defaults",

  "daemon": {
    "address": "http://localhost:11987"
  },

  "device_detection": {
    "mode": "strict",
    "allowlist": "",
    "blocklist": "mainboard\nmotherboard\nchipset"
  },

  "paths": {
    "images": "/var/lib/coolercontrol/plugins/coolerdash",
    "image_coolerdash": "/var/lib/coolercontrol/plugins/coolerdash/coolerdash.png",
    "image_background": "",
    "image_shutdown": "/var/lib/coolercontrol/plugins/coolerdash/shutdown.png"
  },

  "display": {
    "mode": "split",
    "circle_switch_interval": 8,
    "circle_layout": "classic",
    "circle_show_load": true,
    "circle_show_rpm": true,
    "circle_show_watts": true,
    "circle_show_frequency": true,
    "circle_show_bar": true,
    "dual_show_bars": true,
    "split_show_load": true,
    "split_show_watts": true,
    "split_show_rpm": false,
    "refresh_interval": 3.5,
    "brightness": 80,
    "orientation": 0,
    "background_image_fit": "cover",
    "background_image_scale_factor": 0,
    "background_overlay_opacity": 0,
    "width": 0,
    "height": 0,
    "content_scale_factor": 0.98,
    "sensor_slot_1": "cpu",
    "sensor_slot_2": "gpu",
    "sensor_slot_3": "none"
  },

  "layout": {
    "bar_height": 20,
    "bar_width": 98,
    "bar_gap": 10,
    "bar_border": 0.6,
    "bar_opacity": 1,
    "bar_border_enabled": 1,
    "label_margin_left": 1,
    "label_margin_bar": 1,
    "bar_height_1": 0,
    "bar_height_2": 0,
    "bar_height_3": 0
  },

  "colors": {
    "display_background": { "r": 0, "g": 0, "b": 0 },
    "bar_background": { "r": 52, "g": 52, "b": 52 },
    "bar_border": { "r": 192, "g": 192, "b": 192 },
    "font_temp": { "r": 255, "g": 255, "b": 255 },
    "font_label": { "r": 200, "g": 200, "b": 200 }
  },

  "font": {
    "face": "Roboto Black",
    "size_temp": 0,
    "size_labels": 0,
    "size_duty": 0,
    "size_watts": 0
  },

  "sensors": {
    "cpu": {
      "threshold_1": 55,
      "threshold_2": 65,
      "threshold_3": 75,
      "max_scale": 115,
      "threshold_1_color": { "r": 0, "g": 255, "b": 0 },
      "threshold_2_color": { "r": 255, "g": 140, "b": 0 },
      "threshold_3_color": { "r": 255, "g": 70, "b": 0 },
      "threshold_4_color": { "r": 255, "g": 0, "b": 0 },
      "font_size_temp": 0,
      "label": "",
      "label_to_bar_gap": 0,
      "value_to_bar_gap": 0,
      "offset_x": 0,
      "offset_y": 0
    },
    "gpu": {
      "threshold_1": 55,
      "threshold_2": 65,
      "threshold_3": 75,
      "max_scale": 115,
      "threshold_1_color": { "r": 0, "g": 255, "b": 0 },
      "threshold_2_color": { "r": 255, "g": 140, "b": 0 },
      "threshold_3_color": { "r": 255, "g": 70, "b": 0 },
      "threshold_4_color": { "r": 255, "g": 0, "b": 0 },
      "font_size_temp": 0,
      "label": "",
      "label_to_bar_gap": 0,
      "value_to_bar_gap": 0,
      "offset_x": 0,
      "offset_y": 0
    },
    "liquid": {
      "threshold_1": 30,
      "threshold_2": 35,
      "threshold_3": 40,
      "max_scale": 60,
      "threshold_1_color": { "r": 0, "g": 255, "b": 0 },
      "threshold_2_color": { "r": 255, "g": 140, "b": 0 },
      "threshold_3_color": { "r": 255, "g": 70, "b": 0 },
      "threshold_4_color": { "r": 255, "g": 0, "b": 0 },
      "font_size_temp": 0,
      "label": "",
      "label_to_bar_gap": 0,
      "value_to_bar_gap": 0,
      "offset_x": 0,
      "offset_y": 0
    }
  },

  "positioning": {
    "degree_spacing": 12,
    "label_offset_x": 0,
    "label_offset_y": 0,
    "margin_top": 0,
    "margin_bottom": 0
  }
}
